{
  // Base config used for editor type-checking and `npm run typecheck`.
  // Covers all of src/, which as of Phase 5 is TypeScript end to end -
  // there is no `allowJs` escape hatch anymore, so a stray .js file under
  // src/ is simply not part of the program and any import of it fails to
  // resolve rather than silently going unchecked.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Matches package.json's "type": "module" - relative imports in .ts
    // source must use the future compiled `.js` extension, e.g.
    // `import { User } from '../domain/entities/User.js'` even though only
    // User.ts exists on disk right now. This is a real NodeNext+TS
    // requirement, not a mistake - see docs/BACKEND_REWRITE_PLAN.md §4.
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
