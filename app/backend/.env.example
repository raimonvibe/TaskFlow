# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
# Prefer DATABASE_URL for hosted Postgres (Neon, Render, etc.). When set, it
# takes priority over the discrete DB_* vars and enables SSL automatically.
# For Neon on Render, use the *direct* host (ep-….neon.tech), not the
# pooled host (ep-…-pooler.neon.tech): db:init applies schema.sql as one
# multi-statement query, which transaction-mode PgBouncer rejects.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require  # trufflehog:ignore
# First connection after Neon suspends compute can take several seconds;
# DATABASE_URL already raises the pool timeout to 30s. Override if needed:
# DB_CONNECTION_TIMEOUT_MS=30000

# Defaults to the Postgres that docker-compose.yml starts (it publishes
# 5432 on localhost), so `npm run dev` and `npm test` work against the same
# database the containers use. These credentials must stay in sync with
# docker-compose.yml's POSTGRES_USER / POSTGRES_PASSWORD.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow_user
DB_PASSWORD=taskflow_password

# When the backend itself runs inside Docker Compose, it reaches Postgres by
# service name rather than localhost - docker-compose.yml already sets this
# for the container, so it's only relevant if you run the image by hand.
# DB_HOST=postgres

# JWT Configuration
JWT_SECRET=change_this_to_a_random_secure_string_in_production
# Short-lived access token; the refresh token keeps the session alive.
JWT_EXPIRE=15m
# HMAC key for hashing opaque refresh tokens (must differ from JWT_SECRET).
JWT_REFRESH_SECRET=change_this_to_a_different_random_secure_string
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
