# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
# Defaults to the Postgres that docker-compose.yml starts (it publishes
# 5432 on localhost), so `npm run dev` and `npm test` work against the same
# database the containers use. These credentials must stay in sync with
# docker-compose.yml's POSTGRES_USER / POSTGRES_PASSWORD.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow_user
DB_PASSWORD=taskflow_password

# When the backend itself runs inside Docker Compose, it reaches Postgres by
# service name rather than localhost - docker-compose.yml already sets this
# for the container, so it's only relevant if you run the image by hand.
# DB_HOST=postgres

# JWT Configuration
JWT_SECRET=change_this_to_a_random_secure_string_in_production
JWT_EXPIRE=7d

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
