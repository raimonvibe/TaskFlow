{
  // Used by `npm run build` (tsc -p tsconfig.build.json) to emit dist/,
  // which is what production actually runs (`node dist/main.js`) - see the
  // Dockerfile's build stage and render.yaml's buildCommand.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false
  },
  // src/database/*.js is listed explicitly because nothing imports it -
  // init-schema.js is its own entrypoint (`npm run db:init`), so tsc would
  // not otherwise pull it into the program and dist/ would be missing the
  // script the container runs before start. seed.js rides along for the
  // same reason.
  "include": ["src/**/*.ts", "src/database/**/*.js"],
  // Test files and the fakes they use are not part of the shipped image.
  "exclude": ["node_modules", "dist", "coverage", "src/**/*.test.ts", "src/test/**"]
}
