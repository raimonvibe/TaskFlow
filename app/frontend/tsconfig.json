{
  // Phase 1 of the frontend TypeScript adoption (docs/NEXT_STEPS.md Option B).
  // allowJs stays on until every .js/.jsx under src/ is converted; then drop
  // it the way the backend rewrite did in its Phase 5. typecheck only
  // considers .ts/.tsx today so a half-migrated tree stays green.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.js"],
  "exclude": ["node_modules", "dist", "coverage"]
}
