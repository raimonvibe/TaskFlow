# TaskFlow Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskflow
DB_USER=taskflow_user
DB_PASSWORD=change_this_secure_password

# JWT Configuration
JWT_SECRET=change_this_to_a_long_random_secure_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secure_string
JWT_REFRESH_EXPIRE=7d

# API Configuration
API_URL=http://localhost:3000

# CORS (comma-separated list)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Environment
NODE_ENV=production

# docker-compose port overrides (all optional - defaults shown below).
# Every service binds to 127.0.0.1 only, so these are unreachable from other
# devices on your network regardless of the value. Change one here if the
# default is already taken by something else on your machine, e.g. if you
# see "port is already allocated" when running docker-compose up.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=3000
# FRONTEND_PORT=5173
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# ADMINER_PORT=8080
