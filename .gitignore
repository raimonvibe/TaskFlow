# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing
# Unanchored, so these match app/backend/coverage and app/frontend/dist too -
# a leading slash would only ever match the repo root.
coverage/

# Production
dist/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Terraform
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Ansible
*.retry

# Kubernetes
kubeconfig

# Secrets
secrets.yml
*.pem
*.key
!*.key.example

# Docker
.dockerignore

# Claude Code — personal, machine-local settings (settings.json is the
# shared one and stays tracked)
.claude/settings.local.json

# Misc
tmp/
temp/
